<VBox alignment="TOP_CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.randychurunel.system.controllers.RegistroController">
   <children>
      <ImageView fitHeight="150.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true" VBox.vgrow="ALWAYS">
         <viewport>
            <Rectangle2D />
         </viewport>
         <image>
            <Image url="@../../reosources/images/a61b4c400f78305a2b1af2c4279cdce9.png" />
         </image>
      </ImageView>
      <GridPane prefHeight="233.0" prefWidth="541.0">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints minHeight="10.0" prefHeight="30.0" valignment="CENTER" vgrow="ALWAYS" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" valignment="CENTER" vgrow="ALWAYS" />
            <RowConstraints minHeight="10.0" prefHeight="30.0" valignment="CENTER" vgrow="ALWAYS" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" valignment="CENTER" vgrow="ALWAYS" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
            <RowConstraints maxHeight="56.0" minHeight="10.0" prefHeight="24.0" vgrow="SOMETIMES" />
          <RowConstraints maxHeight="38.0" minHeight="0.0" prefHeight="32.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
           <Label alignment="CENTER" text="Ingrese usuario" GridPane.columnIndex="0" GridPane.rowIndex="0" />
<Label alignment="CENTER" text="ingrese su nombre" GridPane.columnIndex="0" GridPane.rowIndex="1" />
<Label alignment="CENTER" text="ingrese su correo" GridPane.columnIndex="0" GridPane.rowIndex="2" />
<Label alignment="CENTER" text="ingrese su apellido" GridPane.columnIndex="0" GridPane.rowIndex="3" />
<Label alignment="CENTER" text="ingrese su contraseña" GridPane.columnIndex="0" GridPane.rowIndex="4" />
<Label alignment="CENTER" text="confirmar su contraseña" GridPane.columnIndex="0" GridPane.rowIndex="5" />
            
           <TextField fx:id="txtUser" GridPane.columnIndex="1" GridPane.rowIndex="0" />
<TextField fx:id="txtName" GridPane.columnIndex="1" GridPane.rowIndex="1" />
<TextField fx:id="txtEmail" GridPane.columnIndex="1" GridPane.rowIndex="2" />
<TextField fx:id="txtLastName" GridPane.columnIndex="1" GridPane.rowIndex="3" />
<PasswordField fx:id="pwdPass" GridPane.columnIndex="1" GridPane.rowIndex="4" />
<PasswordField fx:id="pwdConfirmPass" GridPane.columnIndex="1" GridPane.rowIndex="5" />
            <HBox prefHeight="100.0" prefWidth="200.0" GridPane.columnIndex="1" GridPane.rowIndex="6" />
         </children>
      </GridPane>
      <Button fx:id="btnCreateUser" alignment="TOP_CENTER" contentDisplay="CENTER" mnemonicParsing="false" onMouseClicked="#onRegister" text="crear User" textAlignment="CENTER" textFill="#a41b1b" textOverrun="CENTER_ELLIPSIS">
         <font>
            <Font name="Candara Bold Italic" size="12.0" />
         </font>
      </Button>
      <Button fx:id="btnCancel" mnemonicParsing="false" onMouseClicked="#onCancelRegistro" text="cancelar user " />
